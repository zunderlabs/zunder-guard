#!/bin/sh
# TEST DOUBLE for cosign (deploy/guard/test/installer.sh). A real Sigstore bundle cannot be made
# without publishing to the public transparency log, so the test release carries a fake bundle:
# {"identity": "<signer>", "sha256": "<sha256 of SHA256SUMS>"}. This stand-in accepts it only if
# the identity and issuer the installer demands are the bundle's and the hash matches the file,
# so the tests still show that a tampered file or another release's signature is refused.
# It is never shipped: package.sh and render.sh do not include it.
set -eu
[ "${1:-}" = verify-blob ] || { echo "fake cosign: only verify-blob" >&2; exit 2; }
shift
bundle="" identity="" issuer="" file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --bundle) bundle=$2 && shift 2 ;;
    --certificate-identity) identity=$2 && shift 2 ;;
    --certificate-oidc-issuer) issuer=$2 && shift 2 ;;
    -*) echo "fake cosign: unexpected option $1" >&2 && exit 2 ;;
    *) file=$1 && shift ;;
  esac
done
[ "$issuer" = https://token.actions.githubusercontent.com ] || { echo "fake cosign: wrong issuer" >&2; exit 1; }
want_id=$(sed -n 's/.*"identity": *"\([^"]*\)".*/\1/p' "$bundle")
want_sha=$(sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p' "$bundle")
[ "$identity" = "$want_id" ] || { echo "fake cosign: identity $identity is not the signer $want_id" >&2; exit 1; }
# Hash stdin so GNU's filename escaping cannot prefix the digest with a backslash.
[ "$(sha256sum < "$file" | cut -d' ' -f1)" = "$want_sha" ] || { echo "fake cosign: $file does not match the bundle" >&2; exit 1; }
echo "Verified OK (fake cosign)" >&2
