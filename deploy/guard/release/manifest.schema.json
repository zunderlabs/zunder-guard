{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zunder Guard immutable build manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "tag",
    "commit",
    "published_at",
    "assets",
    "signing",
    "distribution",
    "platforms"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "url"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/zunderlabs/zunder-guard/releases/download/"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "issuer"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^https://github\\.com/zunderlabs/zunder-guard/\\.github/workflows/release\\.yml@refs/tags/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
        },
        "issuer": {
          "const": "https://token.actions.githubusercontent.com"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux-amd64",
          "linux-arm64",
          "darwin-arm64",
          "darwin-amd64",
          "windows-amd64"
        ]
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unix_loader",
        "windows_loader",
        "homebrew",
        "docker",
        "archive",
        "aws_template",
        "container_native"
      ],
      "properties": {
        "unix_loader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "const": "curl -fsSL https://zunderlabs.com/i | sh"
            }
          }
        },
        "windows_loader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "const": "irm https://zunderlabs.com/i.ps1 | iex"
            }
          }
        },
        "homebrew": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "const": "brew install zunderlabs/tap/zunder-guard"
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "digest"
          ],
          "properties": {
            "image": {
              "const": "ghcr.io/zunderlabs/zunder-guard"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "aws_template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "container_native": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    }
  }
}
